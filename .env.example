# --- OpenRouter (required for parsing and eval) ---
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Model used for text-layer documents (OpenRouter id)
DEFAULT_TEXT_MODEL=google/gemini-2.5-flash-lite
# Model used for scans / native PDF input (OpenRouter id)
DEFAULT_VISION_MODEL=google/gemini-2.5-flash-lite

# --- Neon Postgres (required for upload, viewer, eval) ---
# Pooled connection string from the Neon dashboard
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Cloudflare R2 (required for upload and samples:upload only) ---
# Cloudflare account id
R2_ACCOUNT_ID=replace-me
# R2 API token access key id
R2_ACCESS_KEY_ID=replace-me
# R2 API token secret
R2_SECRET_ACCESS_KEY=replace-me
# Bucket name
R2_BUCKET=discovery-parser
# Public CDN base URL for the bucket, no trailing slash
R2_PUBLIC_BASE_URL=https://cdn.example.com
